{
  "name": "codereplay",
  "version": "0.1.0",
  "description": "Deterministic, Git-native code replay engine for AI-generated codebases",
  "type": "module",
  "bin": { "codereplay": "./dist/cli.js" },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ui','dist/ui',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:probe": "tsx src/cli.ts mcp probe --e2e",
    "test:probe:json": "tsx src/cli.ts mcp probe --json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}
