{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codereplay.dev/schema/v2.1.json",
  "title": "CodeReplay Manifest",
  "type": "object",
  "required": ["spec_version", "project_metadata", "steps"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string", "const": "2.1" },
    "project_metadata": {
      "type": "object",
      "required": ["name", "scope_type", "target_commit", "scoped_paths"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope_type": { "type": "string", "enum": ["FULL", "PARTIAL"] },
        "target_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scoped_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Step" }
    }
  },
  "definitions": {
    "Step": {
      "type": "object",
      "required": ["step_id", "title", "commit_message", "explanation", "code_changes"],
      "additionalProperties": false,
      "properties": {
        "step_id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "commit_message": { "type": "string", "minLength": 1 },
        "explanation": {
          "type": "object",
          "required": ["markdown"],
          "additionalProperties": false,
          "properties": {
            "markdown": { "type": "string" },
            "diagram": { "type": "string" },
            "math": { "type": "array", "items": { "type": "string" } }
          }
        },
        "code_changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Change" }
        }
      }
    },
    "Change": {
      "type": "object",
      "required": ["path", "action"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["CREATE", "MODIFY", "DELETE", "RENAME"] },
        "old_path": { "type": "string" },
        "content": { "type": "string" },
        "patch": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "RENAME" } } },
          "then": { "required": ["old_path"] }
        },
        {
          "if": { "properties": { "action": { "const": "CREATE" } } },
          "then": { "anyOf": [{ "required": ["content"] }, { "required": ["patch"] }] }
        },
        {
          "if": { "properties": { "action": { "const": "MODIFY" } } },
          "then": { "anyOf": [{ "required": ["content"] }, { "required": ["patch"] }] }
        }
      ]
    }
  }
}
